# =============================================================================
# Self-Service Regulatory Knowledge Assistant — environment configuration
# Copy to .env and fill in secrets. Values below are the ones from
# docs/MASTER_DEVELOPMENT_SPEC.md §91, pre-filled with working local-dev
# defaults so `docker compose up -d` + the apps run out of the box.
#
# Vars marked (added) are NOT in the spec's §91 list — they were added
# because the running app genuinely needs them. See ADR-013.
# =============================================================================

# DATABASE
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot
POSTGRES_USER=chatbot          # (added) consumed by docker-compose postgres service
POSTGRES_PASSWORD=chatbot      # (added) consumed by docker-compose postgres service
POSTGRES_DB=chatbot            # (added) consumed by docker-compose postgres service

# REDIS
REDIS_URL=redis://localhost:6379/0

# QDRANT
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OBJECT STORAGE
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=chatbot-documents

# HUGGING FACE
HF_TOKEN=

# MODEL ROUTING
LLM_FAST_MODEL=openai/gpt-oss-20b:groq
LLM_STRONG_MODEL=openai/gpt-oss-120b:groq
LLM_FAST_FALLBACK=
LLM_STRONG_FALLBACK=

# VOYAGE
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-context-4
RERANK_MODEL=rerank-2.5-lite
VOYAGE_EMBEDDING_DIMENSION=1024  # (added) apps/api's query-time embedding, mirrors the worker's dimension

# ANALYTICS (added, M14) — rough per-tier cost estimate, not precise billing
LLM_FAST_COST_PER_1K_TOKENS=0.0
LLM_STRONG_COST_PER_1K_TOKENS=0.0

# RETRIEVAL
DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANK_TOP_K=6
FUSION_TOP_K=20  # (added) M7's RRF-fused candidate count handed to M8's reranker

# FILE (per-file limit — separate from any total archive size)
MAX_FILE_SIZE_MB=100

# LAN ARCHIVE CONNECTOR (LAN-M1, ADR-020) — pilot defaults, not benchmarked.
# See docs/ADDENDUM_LAN_ARCHIVE_4TB_COST_CONTROL.md and
# docs/operations/LAN_CONNECTOR_RUNBOOK.md before enabling in production.
CONNECTOR_ENABLED=false
CONNECTOR_ALLOWED_HOSTS=
SCAN_PAGE_SIZE=500
SCAN_STABILITY_WINDOW_SECONDS=30

# STRUCTURE
STRUCTURE_HIGH_CONFIDENCE=0.90
STRUCTURE_REVIEW_THRESHOLD=0.70

# CHAT
MAX_RECENT_MESSAGES=8
ENABLE_SEMANTIC_CACHE=true
ANSWER_CACHE_TTL_SECONDS=600

# PERFORMANCE
LLM_REQUEST_TIMEOUT=30
RETRIEVAL_TIMEOUT=10

# APP (added) — needed for FastAPI app config/CORS/logging
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# AUTH (added) — JWT session cookie, see ADR-015. Generate a real secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
SESSION_COOKIE_NAME=session

# WEB (added) — Next.js needs to know where the API lives
NEXT_PUBLIC_API_URL=http://localhost:8000
